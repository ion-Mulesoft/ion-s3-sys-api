<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<groupId>352aa555-43cd-4805-8d05-796eb1dff8cf</groupId>
	<artifactId>ion-s3-sys-api-v2-dev</artifactId>
	<version>1.0.0</version>
	<packaging>mule-application</packaging>

	<name>ion-s3-sys-api-v2-dev</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<app.runtime>4.9.9</app.runtime>
		<mule.maven.plugin.version>4.1.0</mule.maven.plugin.version>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.2.0</version>
			</plugin>
			<plugin>
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>mule-maven-plugin</artifactId>
				<version>${mule.maven.plugin.version}</version>
				<extensions>true</extensions>
				<configuration>
					<!-- Default empty; profiles will override -->
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- keep all your connectors -->
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-http-connector</artifactId>
			<version>1.9.1</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-apikit-module</artifactId>
			<version>1.10.3</version>
			<classifier>mule-plugin</classifier>
		</dependency>
	</dependencies>

	<repositories>
		<repository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>https://repository.mulesoft.org/releases/</url>
			<layout>default</layout>
		</repository>
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange V3</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
			<layout>default</layout>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<layout>default</layout>
			<url>https://repository.mulesoft.org/releases/</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>

	<profiles>
		<!-- Profile 1: Build Only (manual upload) -->
		<profile>
			<id>build-only</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<muleDeploy>false</muleDeploy>
			</properties>
		</profile>

		<!-- Profile 2: CloudHub 2.0 Deploy -->
		<profile>
			<id>cloudhub2</id>
			<properties>
				<anypoint.connectedApp.clientId>69b04250ea604d8f9023eccad21f653c</anypoint.connectedApp.clientId>
				<anypoint.connectedApp.clientSecret>8058D7987F70416cb6aD0a5113523695</anypoint.connectedApp.clientSecret>
				<anypoint.organization>352aa555-43cd-4805-8d05-796eb1dff8cf</anypoint.organization>
				<anypoint.target>9c69c302-6e31-465e-9418-7d65287ed504</anypoint.target>
				<mule.application.name>test</mule.application.name>
				<mule.environment>Sandbox</mule.environment>
				<mule.region>us-east-2</mule.region>
				<muleDeploy>true</muleDeploy>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.mule.tools.maven</groupId>
						<artifactId>mule-maven-plugin</artifactId>
						<version>${mule.maven.plugin.version}</version>
						<extensions>true</extensions>
						<configuration>
							<cloudHub2Deployment>
								<uri>https://anypoint.mulesoft.com</uri>
								<applicationName>${mule.application.name}</applicationName>
								<environment>${mule.environment}</environment>
								<region>${mule.region}</region>
								<workers>1</workers>
								<workerType>MICRO</workerType>
								<connectedAppClientId>${anypoint.connectedApp.clientId}</connectedAppClientId>
								<connectedAppClientSecret>${anypoint.connectedApp.clientSecret}</connectedAppClientSecret>
								<organization>${anypoint.organization}</organization>
								<target>${anypoint.target}</target>
							</cloudHub2Deployment>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
